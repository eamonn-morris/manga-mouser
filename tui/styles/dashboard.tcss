Screen {
    layout: vertical;
}

#main {
    width: 100%;
    height: 1fr;
    padding: 1;
}

/* Status Panel */
#status {
    height: 3;
    padding: 0 1;
    background: $surface;
}

#status-line {
    width: 100%;
}

/* Watchlist Panel */
#watchlist {
    height: auto;
    background: transparent;
}

#watchlist-collapsible {
    height: auto;
    background: transparent;
}

#watchlist-content {
    height: auto;
    max-height: 10;
    overflow-y: auto;
    background: transparent;
}

#watchlist-input {
    margin-top: 1;
    width: 100%;
}

/* Downloads Table */
#downloads {
    height: 1fr;
    margin: 1 0;
    background: transparent;
}

DataTable {
    background: transparent;
}

DataTable > .datatable--header {
    background: transparent;
}

DataTable > .datatable--cursor {
    background: $accent;
}

DataTable > .datatable--odd-row {
    background: transparent;
}

DataTable > .datatable--even-row {
    background: transparent;
}

/* Activity Log */
#log {
    height: 10;
    border: solid $primary;
    padding: 0 1;
    background: transparent;
}

Rule {
    margin: 1 0;
    color: $primary-darken-2;
}
