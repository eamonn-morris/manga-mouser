Screen {
    layout: vertical;
}

#main {
    width: 100%;
    height: 1fr;
    padding: 1;
}

/* Status Panel */
#status {
    height: 3;
    padding: 0 1;
    background: $boost;
}

#status-line {
    width: 100%;
}

/* Watchlist Panel */
#watchlist {
    height: auto;
    max-height: 12;
}

#watchlist-collapsible {
    height: auto;
    max-height: 10;
}

#watchlist-content {
    height: auto;
    max-height: 8;
    overflow-y: auto;
}

/* Downloads Table */
#downloads {
    height: 1fr;
    margin: 1 0;
}

/* Activity Log */
#log {
    height: 10;
    border: solid $primary;
    padding: 0 1;
}

Rule {
    margin: 1 0;
    color: $primary-darken-2;
}
